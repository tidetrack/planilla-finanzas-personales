node_modules/
.clasp/
.claspignore
*.command
# Excepcion: el script de deploy oficial SI se versiona (Fase 1 del arnes).
# *.command protege launchers locales (ej. iniciar_autosync.command).
!sync_targets.command
package-lock.json
# Apps Script metadata if desired to ignore local ones
# .clasp.json

.DS_Store
.vscode/
_backup/
.impeccable/

# Secrets - NUNCA versionar
.env
.env.local
.env.*.local

# Configuracion LOCAL del arrancador de preview. Lleva una ruta absoluta de la maquina porque
# el proceso arranca en un directorio que el sandbox no deja leer, asi que una ruta relativa no
# resuelve. Es config de herramienta, no del producto: se regenera con
# devtools/regenerar_servidor_shell.py --launch
.claude/launch.json
